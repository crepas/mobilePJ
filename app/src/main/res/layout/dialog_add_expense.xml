<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- 헤더 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💳 지출 추가"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:layout_marginBottom="24dp"
        android:layout_gravity="center" />

    <!-- 지출 제목 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="지출 제목"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/editTextExpenseTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="예: 점심식사, 호텔 비용"
        android:inputType="text"
        android:background="@drawable/edit_text_background"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- 금액 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="금액 (원)"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/editTextExpenseAmount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="0"
        android:inputType="number"
        android:background="@drawable/edit_text_background"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- 카테고리 선택 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="카테고리"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerExpenseCategory"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_background"
        android:layout_marginBottom="16dp" />

    <!-- 날짜 선택 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="지출 날짜"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/editTextExpenseDate"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="날짜 선택"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/buttonSelectDate"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="📅"
            android:textSize="16sp"
            android:background="@drawable/button_outline_background"
            android:paddingHorizontal="16dp" />

    </LinearLayout>

    <!-- 메모 (선택사항) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="메모 (선택사항)"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/editTextExpenseNote"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:hint="추가 메모를 입력하세요"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:background="@drawable/edit_text_background"
        android:padding="12dp"
        android:layout_marginBottom="24dp" />

    <!-- 버튼들 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/buttonCancelExpense"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="취소"
            android:textSize="14sp"
            android:background="@drawable/button_outline_background"
            android:textColor="#666666"
            android:paddingHorizontal="24dp"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/buttonSaveExpense"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="저장"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_background"
            android:paddingHorizontal="24dp" />

    </LinearLayout>

</LinearLayout>