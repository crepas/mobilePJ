<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 다이얼로그 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✈️"
                android:textSize="32sp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewDetailTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="여행 제목"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FF5722" />

                <TextView
                    android:id="@+id/textViewDetailSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="여행 상세 정보"
                    android:textSize="12sp"
                    android:textColor="#666666" />

            </LinearLayout>

        </LinearLayout>

        <!-- 목적지 정보 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="목적지"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

            </LinearLayout>

            <TextView
                android:id="@+id/textViewDetailDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="목적지 정보"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginStart="24dp" />

        </LinearLayout>

        <!-- 날짜 정보 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="여행 기간"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

            </LinearLayout>

            <TextView
                android:id="@+id/textViewDetailDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2024.01.01 ~ 2024.01.05"
                android:textSize="16sp"
                android:textColor="#2196F3"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/textViewDetailDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰ 5일간의 여행"
                android:textSize="12sp"
                android:textColor="#FF5722"
                android:layout_marginStart="24dp" />

        </LinearLayout>

        <!-- 설명 -->
        <LinearLayout
            android:id="@+id/layoutDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="여행 설명"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

            </LinearLayout>

            <TextView
                android:id="@+id/textViewDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="여행 설명"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginStart="24dp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <!-- 여행 상태 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="여행 상태"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

            </LinearLayout>

            <TextView
                android:id="@+id/textViewDetailStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 예정된 여행"
                android:textSize="14sp"
                android:textColor="#4CAF50"
                android:layout_marginStart="24dp"
                android:background="#E8F5E8"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>